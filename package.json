{
  "name": "ttyhand",
  "version": "0.0.1",
  "description": "Let agents drive interactive terminal programs through a real PTY — over MCP or a CLI.",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "spike": "tsx src/spike.ts",
    "test": "tsup --silent && tsx --test test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "ttyhand": "dist/cli.js"
  },
  "packageManager": "pnpm@11.3.0"
}
